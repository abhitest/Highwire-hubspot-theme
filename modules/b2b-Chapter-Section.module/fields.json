  {
    "name": "content_group",
    "label": "Content",
    "type": "group",
    "children": [
      {
        "name": "heading",
        "label": "Heading",
        "type": "text",
        "default": "Tensions Shaping Technology?s Next Chapter"
      },
      {
        "name": "intro",
        "label": "Introduction",
        "type": "text",
        "default": "Technology leaders are navigating a market where expectations keep rising and the rules keep changing. We see five recurring tensions that can shape a company’s reputation, category position, executive influence, growth, and ability to prove impact."
      },
      {
        "name": "chapters",
        "label": "Chapters",
        "type": "group",
        "occurrence": {
          "min": 1,
          "max": 10,
          "default": 5
        },
        "children": [
          {
            "name": "title",
            "label": "Title",
            "type": "text"
          },
          {
            "name": "description",
            "label": "Description",
            "type": "text",
            "allow_new_line": true
          }
        ],
        "default": [
          {
            "title": "Unsung Reputation",
            "description": "Your product has evolved — and so has the opportunity. The companies that move fastest to reset their narrative around the value they deliver today determine how their category gets defined next."
          },
          {
            "title": "Uncertain Category Position",
            "description": "AI-native competitors are redrawing familiar categories and claiming new ground. The leaders who move now to sharpen their expertise, clarify their product direction, and amplify their executive point of view are the ones whose messages will break through."
          },
          {
            "title": "Unknown Executives",
            "description": "Your leaders need a credible public voice across media, events, LinkedIn, and high-stakes market moments. Build a repeatable visibility program that turns executive expertise into lasting influence."
          },
          {
            "title": "Mixed Messages",
            "description": "The companies that bring PR, product marketing, content, and demand together around a cohesive narrative eliminate missed opportunities and create a compounding advantage as every channel reinforces the same story."
          },
          {
            "title": "Proof of ROI",
            "description": "Reach and impressions cannot tell the full story. Connect market visibility, message adoption, engagement, and demand signals to the outcomes your CEO, sales leaders, and board care about."
          }
        ]
      },
      {
        "name": "cta_label",
        "label": "Panel link label",
        "type": "text",
        "default": "Let?s talk about it"
      },
      {
        "name": "cta_url",
        "label": "Panel link",
        "type": "url",
        "supported_types": [
          "CONTENT",
          "EXTERNAL"
        ],
        "default": {
          "type": "EXTERNAL",
          "href": "#contact"
        }
      }
    ]
  },

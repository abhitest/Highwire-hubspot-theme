        "default": [
          {
            "title": "Strategy & Intelligence",
            "description": "Every program starts with a sharper understanding of the landscape it will operate in. We build the market intelligence, audience insight, and competitive context that make every activation more precisely targeted and every decision clearly grounded in where the market is moving.",
            "icon": {
              "src": "https://highwire-demo.vercel.app/images/icons/industry/search.svg",
              "alt": "",
              "size_type": "auto",
              "width": 24,
              "height": 24
            }
          },
          {
            "title": "Marketing",
            "description": "The full growth engine, from awareness through pipeline. We build and activate programs across every channel where the organizations we work with need to be found, considered, and chosen, with measurement frameworks that connect marketing performance to the revenue conversations that matter most.",
            "icon": {
              "src": "https://highwire-demo.vercel.app/images/icons/industry/target.svg",
              "alt": "",
              "size_type": "auto",
              "width": 24,
              "height": 24
            }
          },
          {
            "title": "Communications",
            "description": "Reputation is built over years and tested in moments. We bring the senior counsel, media relationships, and sector fluency to protect and advance reputations across earned media, executive visibility, crisis response, and every channel where the organization’s credibility is at stake.",
            "icon": {
              "src": "https://highwire-demo.vercel.app/images/icons/industry/chat.svg",
              "alt": "",
              "size_type": "auto",
              "width": 24,
              "height": 24
            }
          },
          {
            "title": "Content & Thought Leadership",
            "description": "Intelligence-led content that earns authority with the audiences that shape decisions and produces the commercial results that make every program defensible. We build research-anchored thought leadership that functions as a category asset, compounding in value with every piece that follows.",
            "icon": {
              "src": "https://highwire-demo.vercel.app/images/icons/industry/book-open.svg",
              "alt": "",
              "size_type": "auto",
              "width": 24,
              "height": 24
            }
          },
          {
            "title": "Brand & Creative",
            "description": "Brand is the story an organization tells before anyone asks. We build the strategy, identity, and creative expression that give that story clarity, consistency, and the credibility to hold up in every environment the organization needs to lead.",
            "icon": {
              "src": "https://highwire-demo.vercel.app/images/icons/industry/edit.svg",
              "alt": "",
              "size_type": "auto",
              "width": 24,
              "height": 24
            }
          }
        ]
      }
    ]

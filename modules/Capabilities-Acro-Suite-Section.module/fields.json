[
  {
    "name": "custom_style",
    "label": "Custom Style",
    "type": "group",
    "children": [
      { "name": "custom_class", "label": "Custom class", "type": "text", "default": "" },
      { "name": "section_id", "label": "Section ID", "type": "text", "default": "acro" }
    ]
  },
  {
    "name": "content_group",
    "label": "Content",
    "type": "group",
    "children": [
      {
        "name": "background_image",
        "label": "Background image",
        "type": "image",
        "responsive": true,
        "resizable": true,
        "default": { "src": "https://highwire-demo.vercel.app/images/home/acro/acro-suite.png", "alt": "", "size_type": "auto", "loading": "eager" }
      },
      { "name": "heading", "label": "Heading", "type": "text", "allow_new_line": true, "default": "The Acro\nSuite" },
      { "name": "heading_color", "label": "Heading text color", "type": "color", "default": { "color": "#FFFFFF", "opacity": 100 } },
      { "name": "promise", "label": "Promise", "type": "text", "default": "Close the gap between market signal and action" },
      { "name": "promise_color", "label": "Promise text color", "type": "color", "default": { "color": "#FFFFFF", "opacity": 100 } },
      {
        "name": "description",
        "label": "Description",
        "type": "richtext",
        "allow_new_line": true,
        "default": "<p>Off-the-shelf tools rarely keep up with the complexity of your market. The Acro Suite, Highwire's proprietary AI platform, was built for it, giving your whole program the same real-time read on your market so it can respond as conditions change.</p>"
      },
      { "name": "description_color", "label": "Description text color", "type": "color", "default": { "color": "#FFFFFF", "opacity": 100 } },
      { "name": "animate", "label": "Enable entrance reveal", "type": "boolean", "default": true },
      {
        "name": "products",
        "label": "Products",
        "type": "group",
        "occurrence": { "min": 1, "max": 8, "default": 3, "sorting_label_field": "products.product_name" },
        "children": [
          { "name": "product_name", "label": "Product name after Acro", "type": "text", "default": "" },
          { "name": "background_color", "label": "Card background color", "type": "color", "default": { "color": "#4BB7FF", "opacity": 100 } },
          { "name": "hover_color", "label": "Card hover background color", "type": "color", "default": { "color": "#FFFFFF", "opacity": 100 } },
          {
            "name": "link",
            "label": "Product link",
            "type": "link",
            "supported_types": ["EXTERNAL", "CONTENT"],
            "default": { "url": { "type": "EXTERNAL", "href": "#" }, "open_in_new_tab": false }
          }
        ],
        "default": [
          { "product_name": "<strong>Acro</strong>AI", "background_color": { "color": "#4BB7FF", "opacity": 100 }, "hover_color": { "color": "#FFFFFF", "opacity": 100 }, "link": { "url": { "type": "EXTERNAL", "href": "/acroai" }, "open_in_new_tab": false } },
          { "product_name": "<strong>Acro</strong>Intelligence", "background_color": { "color": "#FA9BFF", "opacity": 100 }, "hover_color": { "color": "#FFFFFF", "opacity": 100 }, "link": { "url": { "type": "EXTERNAL", "href": "/acrointelligence" }, "open_in_new_tab": false } },
          { "product_name": "<strong>Acro</strong>Answers", "background_color": { "color": "#FF7042", "opacity": 100 }, "hover_color": { "color": "#FFFFFF", "opacity": 100 }, "link": { "url": { "type": "EXTERNAL", "href": "/acroanswers" }, "open_in_new_tab": false } }
        ]
      }
    ]
  },

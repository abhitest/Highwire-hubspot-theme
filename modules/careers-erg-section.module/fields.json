      {
        "name": "content",
        "label": "Content",
        "type": "richtext",
        "default": "<p>Guided by the 4Cs (community, culture, career, and commerce), our ERGs bring the right issues to light, the right people to the table, and the right energy to drive lasting change.</p>"
      }
    ]

          "controlling_field_path": "content_group.video_type",
          "controlling_value_regex": "normal",
          "operator": "EQUAL"
        }
      },
      {
        "name": "youtube_url",
        "label": "YouTube URL or video ID",
        "type": "text",
        "visibility": {
          "controlling_field_path": "content_group.video_type",
          "controlling_value_regex": "youtube",
          "operator": "EQUAL"
        }
      },
      {
        "name": "video_title",
        "label": "Accessible video title",
        "type": "text",
        "default": "Highwire work highlight reel"
      },
      {
        "name": "poster",
        "label": "Video poster image",
        "help_text": "Optional cover image for Normal Video or YouTube. HubSpot Video uses its own thumbnail.",
        "type": "image",
        "responsive": true,
        "resizable": true
      },
      {
        "name": "play_label",
        "label": "Play button label",

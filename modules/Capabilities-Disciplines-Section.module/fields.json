            "title": "Communications",
            "promise": "Earn the trust of every audience that shapes your growth",
            "description": "<p>Investors, employees, customers, and policymakers are all forming a view of where your company is headed. Senior counsel alongside your leadership helps each of them see it clearly, building a reputation that strengthens everything else you do, including how you show up in AI answers.</p>",
            "image": { "src": "https://highwire-demo.vercel.app/images/highwire-real/highwire-aspire-1.webp", "alt": "Highwire colleagues discussing their work around a meeting table", "size_type": "auto", "loading": "lazy" },
            "icon": { "src": "https://highwire-demo.vercel.app/images/icons/industry/chat.svg", "alt": "", "size_type": "auto", "loading": "lazy" },

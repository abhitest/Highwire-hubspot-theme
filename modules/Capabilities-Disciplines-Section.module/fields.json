            "cta_label": "Explore Communications"
          },
          {
            "anchor": "content",
            "title": "Content & Thought Leadership",
            "promise": "Build authority that compounds",
            "description": "<p>Your expertise is one of your most valuable assets once the right people can find it and want to read it. Original research and thought leadership turn it into content decision-makers return to, with one consistent story every team can build on.</p>",
            "image": { "src": "https://highwire-demo.vercel.app/images/highwire-real/highwire-aspire-17.webp", "alt": "A Highwire colleague taking notes during a team discussion", "size_type": "auto", "loading": "lazy" },

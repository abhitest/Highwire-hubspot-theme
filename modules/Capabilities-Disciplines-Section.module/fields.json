            "services": "<ul><li>Content strategy</li><li>Thought leadership programs</li><li>Original research and reports</li><li>Editorial and newsletters</li><li>Web and campaign copy</li><li>Content repurposing</li></ul>",
            "cta_label": "Explore Content & Thought Leadership"
          },
          {
            "anchor": "creative",
            "title": "Brand & Creative",
            "promise": "Build a presence that demands attention",
            "description": "<p>Your audience forms an opinion of your brand long before they read a word. Identity, campaigns, video, and motion built on creative strategy make sure what they see looks like a leader.</p>",
            "image": { "src": "https://highwire-demo.vercel.app/images/highwire-real/highwire-aspire-37.webp", "alt": "A Highwire colleague presenting ideas to her team", "size_type": "auto", "loading": "lazy" },
